rules_version = '2';
// Regeln für den Basketball IQ Trainer (siehe README): Online-Rangliste, freiwilliges Konto mit E-Mail-Link
// und weitere Geräte des Kontos, die per QR-Code bzw. Code verbunden wurden (anonyme Anmeldung, ohne persönliche Daten).
service cloud.firestore {
  match /databases/{database}/documents {
    // Angemeldet über den E-Mail-Link (bestätigte Adresse) und Besitzer des Kontos
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true;
    }
    // Besitzer oder ein verbundenes Gerät des Kontos (eingetragen unter accounts/<uid>/devices/<geräte-uid>)
    function member(uid) {
      return owner(uid) || (request.auth != null
        && exists(/databases/$(database)/documents/accounts/$(uid)/devices/$(request.auth.uid)));
    }
    function pair(code) {
      return get(/databases/$(database)/documents/pairs/$(code)).data;
    }

    // Rangliste: Jeder darf lesen und neue Einträge anlegen. Einträge mit Konto tragen dessen uid,
    // nur dieses Konto darf sie löschen (beim Löschen des Kontos). Ändern geht nur in der Firebase-Konsole.
    match /teams/{team}/scores/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name','score','correct','rounds','pos','mode','level','learn','ts','lz','uid'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 14
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 2500
        && request.resource.data.correct is int && request.resource.data.rounds is int
        && request.resource.data.correct >= 0 && request.resource.data.correct <= request.resource.data.rounds
        && request.resource.data.rounds <= 10
        && request.resource.data.pos in ['pg', 'wing', 'center', 'def', 'mix']
        && request.resource.data.mode in [4, 5]
        && request.resource.data.level in [1, 2, 3]
        && request.resource.data.learn is bool
        && request.resource.data.ts is int
        // Lernziele, z. B. "luecke:3/4,zusammen:2/2" (optional)
        && (!('lz' in request.resource.data) || (request.resource.data.lz is string && request.resource.data.lz.size() <= 160))
        // Konto (optional): nur die uid des eigenen Kontos (Besitzer oder verbundenes Gerät)
        && (!('uid' in request.resource.data) || member(request.resource.data.uid));
      allow update: if false;
      allow delete: if request.auth != null && owner(resource.data.get('uid', ''));
    }

    // Kopplungscode zum Verbinden eines weiteren Geräts: legt nur der Besitzer an, gilt höchstens 30 Minuten.
    // Lesen nur mit dem Code selbst (kein Auflisten); löschen darf, wer ihn kennt (nach dem Verbinden).
    match /pairs/{code} {
      allow get: if request.auth != null;
      allow list, update: if false;
      allow create: if code.matches('[A-HJKMNP-Z2-9]{8}')
        && request.resource.data.keys().hasOnly(['acct','exp','mail'])
        && owner(request.resource.data.acct)
        && request.resource.data.exp is int && request.resource.data.exp <= request.time.toMillis() + 1800000
        && request.resource.data.mail is string && request.resource.data.mail.size() <= 80;
      allow delete: if request.auth != null;
    }

    // Konto: Zeitpunkt der Einwilligung und Teams mit Ranglisten-Einträgen.
    // Der Besitzer legt es an und löscht es; verbundene Geräte dürfen nur die Teams ergänzen.
    match /accounts/{uid} {
      allow read: if member(uid);
      allow delete: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['consent','teams'])
        && request.resource.data.consent is int
        && (!('teams' in request.resource.data) || (request.resource.data.teams is string && request.resource.data.teams.size() <= 600));
      allow update: if member(uid)
        && request.resource.data.keys().hasOnly(['consent','teams'])
        && request.resource.data.consent == resource.data.consent
        && (!('teams' in request.resource.data) || (request.resource.data.teams is string && request.resource.data.teams.size() <= 600));

      // Spieler im Konto: Spielerkarte als kompakter Text, Anzahl Spiele, Zeitpunkt
      match /players/{pid} {
        allow read, delete: if member(uid);
        allow create, update: if member(uid)
          && pid.matches('[a-z0-9]{1,12}')
          && request.resource.data.keys().hasOnly(['data','games','ts'])
          && request.resource.data.data is string && request.resource.data.data.size() <= 4000
          && request.resource.data.games is int && request.resource.data.ts is int;
      }

      // Verbundene Geräte: Das Gerät trägt sich selbst ein, nur mit einem gültigen Kopplungscode dieses Kontos.
      // Besitzer und Gerät selbst dürfen den Eintrag lesen und löschen (dann verliert das Gerät den Zugriff).
      match /devices/{dev} {
        allow get, delete: if owner(uid) || (request.auth != null && request.auth.uid == dev);
        allow list: if owner(uid);
        allow update: if false;
        allow create: if request.auth != null && request.auth.uid == dev
          && request.resource.data.keys().hasOnly(['code','name','ts'])
          && request.resource.data.code is string && request.resource.data.code.matches('[A-HJKMNP-Z2-9]{8}')
          && request.resource.data.name is string && request.resource.data.name.size() <= 40
          && request.resource.data.ts is int
          && pair(request.resource.data.code).acct == uid
          && pair(request.resource.data.code).exp > request.time.toMillis();
      }
    }
  }
}
